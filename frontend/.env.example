# Copy to .env, fill in, then restart with: npx expo start -c

# Your FastAPI server. Use your laptop's LAN IP, not localhost: the phone can't reach localhost.
# Leave commented out to use mock analysis results.
# EXPO_PUBLIC_API_URL=http://192.168.1.42:8000

# Supabase project (Dashboard > Project Settings > API). Use the publishable/anon key,
# never the secret/service_role key. Leave commented out to skip the login screen.
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
