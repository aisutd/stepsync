# Copy to .env, fill in, then restart with: npx expo start -c

# Browser default: http://127.0.0.1:8000 (real backend, no mock results).
# Override when needed. For a phone, use your computer's LAN IP instead of localhost.
# EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# Supabase project (Dashboard > Project Settings > API). Use the publishable/anon key,
# never the secret/service_role key. Leave commented out to skip the login screen.
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
