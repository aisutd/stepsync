# Copy to backend/.env and fill in. Loaded with: uvicorn ... --env-file .env
# Supabase project (Dashboard > Project Settings > API Keys). Use the SECRET key
# (sb_secret_... or the legacy service_role key). It bypasses row-level security,
# so it lives only here on the backend: never in the app or in git.
STEPSYNC_SUPABASE_URL=https://your-project.supabase.co
STEPSYNC_SUPABASE_SECRET_KEY=sb_secret_...
