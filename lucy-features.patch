@@ -0,0 +1,41 @@
+-- Same table as features/db.py, for Supabase/Postgres.
+-- video_id is text here; switch it to uuid references reference_videos(id)
+-- once Satwik and Aronno settle the video table.
+create table if not exists pose_features (
+  video_id       text not null,
+  frame_index    integer not null,
+  timestamp_ms   integer not null,
+  frame_status   text not null,          -- OK / LOW_CONFIDENCE / NO_POSE
+  feature        text not null,
+  value          double precision,       -- null when missing, never 0
+  units          text not null,
+  status         text not null check (status in ('ok', 'missing')),
+  missing_reason text,
+  primary key (video_id, frame_index, feature)
+);
+
+-- One row per frame, one column per feature (angles, angle velocities, speeds).
+create or replace view pose_features_wide as
+select video_id, frame_index, timestamp_ms, frame_status,
+  max(value) filter (where feature = 'left_elbow_angle') as left_elbow_angle,
+  max(value) filter (where feature = 'right_elbow_angle') as right_elbow_angle,
+  max(value) filter (where feature = 'left_knee_angle') as left_knee_angle,
+  max(value) filter (where feature = 'right_knee_angle') as right_knee_angle,
+  max(value) filter (where feature = 'left_shoulder_angle') as left_shoulder_angle,
+  max(value) filter (where feature = 'right_shoulder_angle') as right_shoulder_angle,
+  max(value) filter (where feature = 'left_hip_angle') as left_hip_angle,
+  max(value) filter (where feature = 'right_hip_angle') as right_hip_angle,
+  max(value) filter (where feature = 'left_elbow_velocity') as left_elbow_velocity,
+  max(value) filter (where feature = 'right_elbow_velocity') as right_elbow_velocity,
+  max(value) filter (where feature = 'left_knee_velocity') as left_knee_velocity,
+  max(value) filter (where feature = 'right_knee_velocity') as right_knee_velocity,
+  max(value) filter (where feature = 'left_shoulder_velocity') as left_shoulder_velocity,
+  max(value) filter (where feature = 'right_shoulder_velocity') as right_shoulder_velocity,
+  max(value) filter (where feature = 'left_hip_velocity') as left_hip_velocity,
+  max(value) filter (where feature = 'right_hip_velocity') as right_hip_velocity,
+  max(value) filter (where feature = 'left_wrist_speed') as left_wrist_speed,
+  max(value) filter (where feature = 'right_wrist_speed') as right_wrist_speed,
+  max(value) filter (where feature = 'left_ankle_speed') as left_ankle_speed,
+  max(value) filter (where feature = 'right_ankle_speed') as right_ankle_speed
+from pose_features
+group by video_id, frame_index, timestamp_ms, frame_status;
diff --git a/backend/features/supabase_store.py b/backend/features/supabase_store.py
new file mode 100644
index 0000000..b859e69
--- /dev/null
+++ b/backend/features/supabase_store.py
@@ -0,0 +1,71 @@
+"""Save and load feature rows in Supabase (the `pose_features` table).
+
+Run features/schema_postgres.sql in the Supabase SQL editor once to create the
+table. Then set two environment variables (never commit them):
+
+    SUPABASE_URL  e.g. https://<project>.supabase.co
+    SUPABASE_KEY  a key allowed to write the table (service role, or anon with
+                  a row-level-security policy that permits it)
+
+Uses Supabase's REST API through the standard library, so no extra package is
+needed.
+"""
+
+import json
+import os
+import urllib.parse
+import urllib.request
+
+from .db import DB_FIELDS
+from .store import to_db_rows
+
+TABLE = "pose_features"
+BATCH_SIZE = 1000  # Supabase returns at most 1000 rows per request by default.
+
+
+def _settings(url=None, key=None):
+    url = url or os.environ.get("SUPABASE_URL")
+    key = key or os.environ.get("SUPABASE_KEY")
+    if not url or not key:
+        raise RuntimeError("Set SUPABASE_URL and SUPABASE_KEY to use Supabase.")
+    return url.rstrip("/"), key
+
+
+def _request(method, url, key, body=None, extra_headers=None):
+    headers = {"apikey": key, "Authorization": f"Bearer {key}",
+               "Content-Type": "application/json", **(extra_headers or {})}
+    data = None if body is None else json.dumps(body).encode()
+    request = urllib.request.Request(url, data=data, headers=headers, method=method)
+    with urllib.request.urlopen(request, timeout=60) as response:
+        text = response.read().decode()
+        return json.loads(text) if text else None
+
+
+def _video_filter(video_id):
+    return "video_id=eq." + urllib.parse.quote(video_id, safe="")
+
+
+def save_features_supabase(doc, url=None, key=None):
+    """Replace this video's rows in Supabase. Returns the number of rows written."""
+    base, key = _settings(url, key)
+    endpoint = f"{base}/rest/v1/{TABLE}"
+    _request("DELETE", f"{endpoint}?{_video_filter(doc['video_id'])}", key)
+    rows = [{k: row.get(k) for k in DB_FIELDS} for row in to_db_rows(doc)]
+    for start in range(0, len(rows), BATCH_SIZE):
+        _request("POST", endpoint, key, rows[start:start + BATCH_SIZE],
+                 {"Prefer": "return=minimal"})
+    return len(rows)
+
+
+def load_features_supabase(video_id, url=None, key=None):
+    """Rows for one video, ordered by frame then feature, as dicts."""
+    base, key = _settings(url, key)
+    rows, offset = [], 0
+    while True:
+        page = _request(
+            "GET", f"{base}/rest/v1/{TABLE}?select=*&{_video_filter(video_id)}"
+                   f"&order=frame_index,feature&limit={BATCH_SIZE}&offset={offset}", key)
+        rows.extend(page)
+        if len(page) < BATCH_SIZE:
+            return rows
+        offset += BATCH_SIZE
diff --git a/backend/features/velocity.py b/backend/features/velocity.py
new file mode 100644
index 0000000..3f6d834
--- /dev/null
+++ b/backend/features/velocity.py
@@ -0,0 +1,99 @@
+"""Velocity features: how fast joints move between consecutive frames.
+
+- `<angle>_velocity`: change in each joint angle per second (degrees/s).
+  Positive means the joint is opening (straightening), negative closing.
+- `<joint>_speed`: how fast a keypoint moves in MediaPipe's 3D world
+  coordinates (meters/s). World coordinates are centred on the hips, so this is
+  speed relative to the body, not travel across the room.
+
+Each value compares a frame with the frame just before it. It is missing (None,
+with a reason) when the frame has no pose, for the first frame, when either frame lacks the value, or when
+the timestamps don't increase. Missing values are never written as 0.
+"""
+
+import math
+from dataclasses import dataclass
+
+from .angles import FEATURES
+
+
+@dataclass(frozen=True)
+class SpeedFeature:
+    name: str
+    joint: str
+    units: str = "m/s"
+
+
+SPEED_FEATURES = [SpeedFeature(f"{j}_speed", j) for j in
+                  ("left_wrist", "right_wrist", "left_ankle", "right_ankle")]
+ANGLE_VELOCITY_UNITS = "degrees/s"
+
+
+def _missing(row, reason):
+    row["missing_reason"] = reason
+    return row
+
+
+def _base_row(frame, name, units):
+    return {"frame_index": frame.frame_index, "timestamp_ms": frame.timestamp_ms,
+            "frame_status": frame.frame_status, "feature": name, "value": None,
+            "units": units, "status": "missing", "missing_reason": None}
+
+
+def _point(frame, joint):
+    landmark = frame.landmarks.get(joint) if frame.pose_present else None
+    if landmark is None or landmark.world is None or not landmark.reliable:
+        return None
+    return landmark.world
+
+
+def velocity_rows(frames, angle_rows):
+    """Velocity rows for all frames. `angle_rows` are the rows from angles.py."""
+    angle_value = {(r["frame_index"], r["feature"]): r["value"] for r in angle_rows}
+    rows = []
+    previous = None
+    for frame in frames:
+        dt = None if previous is None else (frame.timestamp_ms - previous.timestamp_ms) / 1000
+
+        for feature in FEATURES:
+            row = _base_row(frame, f"{feature.name.removesuffix('_angle')}_velocity",
+                            ANGLE_VELOCITY_UNITS)
+            if not frame.pose_present:
+                rows.append(_missing(row, "no_pose_detected"))
+                continue
+            if previous is None:
+                rows.append(_missing(row, "first_frame"))
+                continue
+            if dt <= 0:
+                rows.append(_missing(row, "non_increasing_timestamp"))
+                continue
+            now = angle_value.get((frame.frame_index, feature.name))
+            before = angle_value.get((previous.frame_index, feature.name))
+            if now is None or before is None:
+                rows.append(_missing(row, "angle_missing_in_this_or_previous_frame"))
+                continue
+            row["value"] = round((now - before) / dt, 3)
+            row["status"] = "ok"
+            rows.append(row)
+
+        for feature in SPEED_FEATURES:
+            row = _base_row(frame, feature.name, feature.units)
+            if not frame.pose_present:
+                rows.append(_missing(row, "no_pose_detected"))
+                continue
+            if previous is None:
+                rows.append(_missing(row, "first_frame"))
+                continue
+            if dt <= 0:
+                rows.append(_missing(row, "non_increasing_timestamp"))
+                continue
+            now, before = _point(frame, feature.joint), _point(previous, feature.joint)
+            if now is None or before is None:
+                rows.append(_missing(row, f"unavailable:{feature.joint}"))
+                continue
+            row["value"] = round(math.dist(now, before) / dt, 4)
+            row["status"] = "ok"
+            rows.append(row)
+
+        previous = frame
+    return rows
