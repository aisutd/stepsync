+from features import compute_features, load_features_db, save_features_db
+
+from test_features import STRAIGHT_ARM, write_pose_csv
+from features import read_pose_csv
+
+
+def doc_for(tmp_path, video_id):
+    csv_path = write_pose_csv(tmp_path / "pose.csv", [(0, 0, "OK", STRAIGHT_ARM),
+                                                       (1, 33, "NO_POSE", {})])
+    return compute_features(video_id, read_pose_csv(csv_path))
+
+
+def test_rows_round_trip_and_missing_stays_null(tmp_path):
+    db = tmp_path / "stepsync.db"
+    doc = doc_for(tmp_path, "reze")
+    assert save_features_db(doc, db) == len(doc["rows"])
+
+    rows = load_features_db(db, "reze")
+    assert len(rows) == len(doc["rows"])
+    elbow = next(r for r in rows if r["frame_index"] == 0 and r["feature"] == "left_elbow_angle")
+    assert elbow["value"] == 180.0 and elbow["status"] == "ok"
+    assert all(r["value"] is None and r["missing_reason"] == "no_pose_detected"
+               for r in rows if r["frame_index"] == 1)
+
+
+def test_saving_again_replaces_only_that_video(tmp_path):
+    db = tmp_path / "stepsync.db"
+    save_features_db(doc_for(tmp_path, "reze"), db)
+    save_features_db(doc_for(tmp_path, "forest"), db)
+    save_features_db(doc_for(tmp_path, "reze"), db)
+    assert len(load_features_db(db, "reze")) == len(load_features_db(db, "forest"))
