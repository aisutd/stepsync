+++ b/backend/features/db.py
@@ -0,0 +1,82 @@
+"""Save feature rows into a database table.
+
+SQLite for now (standard library, one local file). The table matches the one
+proposed in README.md, so the same rows can go into Supabase/Postgres later
+(see features/schema_postgres.sql).
+"""
+
+import sqlite3
+from pathlib import Path
+
+from .store import to_db_rows
+
+DB_FIELDS = ["video_id", "frame_index", "timestamp_ms", "frame_status", "feature",
+             "value", "units", "status", "missing_reason"]
+
+SCHEMA = """
+create table if not exists pose_features (
+  video_id       text not null,
+  frame_index    integer not null,
+  timestamp_ms   integer not null,
+  frame_status   text not null,          -- OK / LOW_CONFIDENCE / NO_POSE
+  feature        text not null,
+  value          real,                   -- null when missing, never 0
+  units          text not null,
+  status         text not null check (status in ('ok', 'missing')),
+  missing_reason text,
+  primary key (video_id, frame_index, feature)
+);
+"""
+
+
+def feature_names():
+    from .angles import FEATURES
+    from .velocity import SPEED_FEATURES
+
+    angles = [f.name for f in FEATURES]
+    velocities = [f"{name.removesuffix('_angle')}_velocity" for name in angles]
+    return angles + velocities + [f.name for f in SPEED_FEATURES]
+
+
+def wide_view_sql(names):
+    """One row per frame, one column per feature: easier to read than the long table."""
+    columns = ",\n  ".join(
+        f"max(case when feature = '{name}' then value end) as {name}" for name in names)
+    return (f"create view pose_features_wide as\n"
+            f"select video_id, frame_index, timestamp_ms, frame_status,\n  {columns}\n"
+            f"from pose_features\ngroup by video_id, frame_index, timestamp_ms, frame_status;")
+
+
+def connect(path):
+    Path(path).parent.mkdir(parents=True, exist_ok=True)
+    conn = sqlite3.connect(path)
+    conn.executescript(SCHEMA)
+    conn.execute("drop view if exists pose_features_wide")
+    conn.execute(wide_view_sql(feature_names()))
+    return conn
+
+
+def save_features_db(doc, path):
+    """Replace this video's rows in the table. Returns the number of rows written."""
+    rows = to_db_rows(doc)
+    with connect(path) as conn:
+        conn.execute("delete from pose_features where video_id = ?", (doc["video_id"],))
+        conn.executemany(
+            f"insert into pose_features ({', '.join(DB_FIELDS)}) "
+            f"values ({', '.join('?' for _ in DB_FIELDS)})",
+            [[row.get(k) for k in DB_FIELDS] for row in rows])
+    conn.close()
+    return len(rows)
+
+
+def load_features_db(path, video_id):
+    """Rows for one video, ordered by frame then feature, as dicts."""
+    conn = connect(path)
+    conn.row_factory = sqlite3.Row
+    try:
+        cursor = conn.execute(
+            "select * from pose_features where video_id = ? order by frame_index, feature",
+            (video_id,))
+        return [dict(r) for r in cursor]
+    finally:
+        conn.close()
